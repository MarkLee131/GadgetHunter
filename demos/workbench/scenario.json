{
  "url": "http://127.0.0.1:8876",
  "viewport": {
    "width": 1280,
    "height": 680
  },
  "scale": 1.5,
  "brandColor": "#0066cc",
  "highlightClicks": true,
  "showKeys": false,
  "gapAfterVoice": 0.8,
  "outroHold": 1,
  "voice": {
    "engine": "openai",
    "model": "gpt-4o-mini-tts",
    "voice": "marin",
    "speed": 1,
    "instructions": "A clear, warm professional software walkthrough for researchers. Speak at a measured, natural pace. Confident but understated. Pronounce GadgetHunter as Gadget Hunter, JAR as jar, and Z3 as zee three."
  },
  "steps": [
    {
      "label": "Analyses",
      "say": "Meet Gadget Hunter. Find Java deserialization candidates, then inspect the evidence behind each result.",
      "actions": [
        {
          "type": "waitFor",
          "selector": "#mode-text:has-text('Local engine connected')"
        }
      ]
    },
    {
      "label": "01 / Add an archive",
      "say": "Start with your application archive and its dependencies. Here, we use a small static-analysis test fixture.",
      "actions": [
        {
          "type": "click",
          "selector": "button[data-page='scan']"
        },
        {
          "type": "fill",
          "selector": "#candidate-form input[name='name']",
          "text": "Static-analysis fixture"
        },
        {
          "type": "upload",
          "selector": "#candidate-form input[name='apps']",
          "files": [
            ".gadgethunter/demo/fixture/static-analysis-fixture.jar"
          ]
        }
      ]
    },
    {
      "label": "02 / Configure the search",
      "say": "Set a search budget and choose automatic taint rules. Built-in candidate generation requires no model API key.",
      "actions": [
        {
          "type": "fill",
          "selector": "#candidate-form input[name='seconds']",
          "text": "90"
        },
        {
          "type": "scroll",
          "selector": "#candidate-form select[name='coverage']",
          "offset": 150
        },
        {
          "type": "highlight",
          "selector": "#candidate-form select[name='coverage']",
          "ms": 1200
        },
        {
          "type": "click",
          "selector": "#candidate-options > summary"
        }
      ],
      "before": [
        {
          "type": "click",
          "selector": "#candidate-options > summary"
        }
      ]
    },
    {
      "label": "03 / Review a saved scan",
      "say": "Here is the saved scan of this fixture. Open its details to inspect candidates and coverage limits.",
      "actions": [
        {
          "type": "click",
          "selector": ".job-row:has-text('Static-analysis fixture \u00b7 candidate scan') button:has-text('Scan details')"
        },
        {
          "type": "waitFor",
          "selector": "#candidate-dialog[open]"
        }
      ],
      "before": [
        {
          "type": "click",
          "selector": "button[data-page='overview']"
        }
      ]
    },
    {
      "label": "Prioritize the review",
      "say": "Review coverage, then follow the ranked clusters. Novel means no catalogued family matched; it is a review priority.",
      "actions": [
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "click",
          "selector": "#coverage-details > summary"
        },
        {
          "type": "hover",
          "selector": "#candidate-detail .triage-row >> nth=2",
          "ms": 1000
        }
      ],
      "before": [
        {
          "type": "click",
          "selector": "#coverage-details > summary"
        }
      ]
    },
    {
      "label": "04 / Add matching source",
      "say": "For source analysis, supply candidate chains and matching Java sources. A configured model helps check semantic reachability.",
      "actions": [
        {
          "type": "fill",
          "selector": "#scan-form input[name='name']",
          "text": "Harmless validation fixture"
        },
        {
          "type": "upload",
          "selector": "#scan-form input[name='chains']",
          "files": [
            ".gadgethunter/demo/fixture/validation-chains.txt"
          ]
        },
        {
          "type": "upload",
          "selector": "#scan-form input[name='sources']",
          "files": [
            ".gadgethunter/demo/fixture/validation-sources.zip"
          ]
        }
      ],
      "before": [
        {
          "type": "click",
          "selector": "#close-candidate"
        },
        {
          "type": "click",
          "selector": "button[data-page='scan']"
        },
        {
          "type": "click",
          "selector": "[data-stage=\"source\"]"
        },
        {
          "type": "scroll",
          "selector": "#scan-form",
          "offset": 35
        }
      ]
    },
    {
      "label": "05 / Open saved evidence",
      "say": "Next, we import a saved analysis of a separate, harmless validation fixture. Reports stay in this browser session.",
      "actions": [
        {
          "type": "upload",
          "selector": "#report-files",
          "files": [
            ".gadgethunter/demo/fixture/saved-validation-report.json"
          ]
        },
        {
          "type": "waitFor",
          "selector": "#evidence-detail h2"
        },
        {
          "type": "scroll",
          "y": -1800
        },
        {
          "type": "click",
          "selector": "#notice button"
        }
      ]
    },
    {
      "label": "06 / Understand the verdict",
      "say": "Filter by verdict. Feasible means the extracted constraints are satisfiable. It does not prove a working exploit.",
      "actions": [
        {
          "type": "select",
          "selector": "#verdict-filter",
          "value": "FEASIBLE"
        },
        {
          "type": "highlight",
          "selector": "#evidence-detail .reasoning",
          "ms": 1500
        }
      ]
    },
    {
      "label": "07 / Trace the reasoning",
      "say": "Follow the call chain and examine the extracted constraints. Each result keeps its supporting evidence available for review.",
      "actions": [
        {
          "type": "scroll",
          "selector": "#evidence-detail .evidence-section",
          "offset": 130
        }
      ]
    },
    {
      "label": "08 / Inspect the source",
      "say": "Expand the matching source to check the method directly, or open the full evidence record for deeper investigation.",
      "actions": [
        {
          "type": "click",
          "selector": "#evidence-detail details summary:has-text('demo.Example')"
        },
        {
          "type": "scroll",
          "selector": "#evidence-detail details summary:has-text('demo.Example')",
          "offset": 140
        }
      ]
    },
    {
      "label": "09 / Keep the evidence",
      "say": "Export the report for later review. Gadget Hunter connects candidate discovery, semantic checks, and constraint evidence in one workflow.",
      "actions": [
        {
          "type": "scroll",
          "y": -1800
        },
        {
          "type": "click",
          "selector": "#export-all"
        }
      ]
    }
  ]
}
